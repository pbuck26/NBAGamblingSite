# Copy this file to .env for local development and fill in real values.
# .env is git-ignored; never commit it.

# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres in production (e.g. Neon). Leave unset to use a local SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
