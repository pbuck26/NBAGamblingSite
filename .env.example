# Copy this file to .env for local development and fill in real values.
# .env is git-ignored; never commit it.

# Long random string, e.g. output of: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Postgres in production (Neon). Leave unset to use a local SQLite file.
# `neon env pull` writes both of these for you (into .env.local, or .env if it exists).
# Pooled connection (hostname has -pooler), used for the app's queries:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection, used to create tables:
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
