{% extends "base.jinja2" %}
{% from "_forms.jinja2" import render_field %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h4 text-center mb-4">Contact me</h2>

        <form method="POST" action="{{ url_for('routes_blueprint.contactPage') }}">
          {{ form.csrf_token }}
          {{ render_field(form.subject) }}
          {{ render_field(form.message, style="height: 12rem") }}
          <div class="text-end">
            {{ form.submit(class_="btn btn-primary px-4") }}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
