{% extends "base.jinja2" %}

{% block content %}
<h2 class="h4">Today's slate</h2>
<p class="text-body-secondary">Model picks for today's games.</p>
<div class="table-responsive">
  <table class="table table-hover align-middle text-center">
    <thead>
      <tr>
        <th>Home</th>
        <th>Away</th>
        <th>Home moneyline</th>
        <th>Pick</th>
        <th>Home win prob</th>
      </tr>
    </thead>
    <tbody>
      {% for game in games %}
      <tr>
        <td><img class="team-logo" src="{{ game.homeTeam }}" alt="Home team"></td>
        <td><img class="team-logo" src="{{ game.awayTeam }}" alt="Away team"></td>
        <td>{{ game.homeOdds }}</td>
        <td><img class="team-logo" src="{{ game.pick }}" alt="Picked team"></td>
        <td>{{ game.prob }}</td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="text-body-secondary">No picks yet for today.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
