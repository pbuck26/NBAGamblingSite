{% extends "base.jinja2" %}
{% from "_forms.jinja2" import render_field %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-sm-10 col-md-7 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h4 text-center mb-4">Sign up</h2>

        <form method="POST" action="{{ url_for('auth_bp.signup') }}">
          {{ form.csrf_token }}
          {{ render_field(form.name, autocomplete="name") }}
          {{ render_field(form.email, autocomplete="email") }}
          {{ render_field(form.password, autocomplete="new-password") }}
          {{ render_field(form.confirm, autocomplete="new-password") }}
          {{ form.submit(class_="btn btn-primary w-100") }}
        </form>

        <p class="text-center small mt-3 mb-0">
          Already have an account? <a href="{{ url_for('auth_bp.login') }}">Log in</a>
        </p>
      </div>
    </div>
  </div>
</div>
{% endblock %}
