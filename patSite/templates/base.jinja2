<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Pat's Gambling Site</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="{{ url_for('static', filename='site.css') }}">
</head>
<body class="d-flex flex-column min-vh-100">
  <nav class="navbar navbar-expand-md navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-semibold" href="{{ url_for('routes_blueprint.renderHomepage') }}">Pat's Gambling Site</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="{{ url_for('routes_blueprint.renderHomepage') }}">Today's picks</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('routes_blueprint.contactPage') }}">Contact</a></li>
          {% if current_user.is_anonymous %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth_bp.signup') }}">Sign up</a></li>
          <li class="nav-item"><a class="nav-link" href="{{ url_for('auth_bp.login') }}">Log in</a></li>
          {% else %}
          <li class="nav-item"><a class="nav-link" href="{{ url_for('routes_blueprint.logout') }}">Log out</a></li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>

  <main class="container flex-grow-1 py-4">
    {% for message in get_flashed_messages() %}
      <div class="alert alert-info alert-dismissible fade show" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    {% endfor %}

    {% block content %}{% endblock %}
  </main>

  <footer class="border-top py-3 small text-body-secondary">
    <div class="container">
      For entertainment only. Picks are model estimates, not guarantees, and past results don't predict future ones.
      You must be 21+ (or of legal age where you live) to bet. Gambling problem? Call 1-800-GAMBLER.
    </div>
  </footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
